{
  "redirects": [
    {
      "source": "/previdenciario.html",
      "destination": "/previdenciario",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/previdenciario",
      "destination": "/previdenciario/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
